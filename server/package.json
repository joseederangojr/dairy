{
  "name": "server",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/main.ts",
    "start": "./server",
    "lint": "biome lint --fix",
    "format": "biome format --fix",
    "check": "biome check --fix"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ulid": "^3.0.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.2"
  }
}
